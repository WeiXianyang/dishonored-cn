# 复制本文件为 .env 并按需调整（.env 已被 .gitignore 排除，不会上传）
# 默认后端：复用本机 `codex login` 的 ChatGPT 登录，不需要 API key
LLM_BACKEND=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
CODEX_CONCURRENCY=1
CODEX_TIMEOUT=1800
# 可选：指定其他 Codex CLI；默认优先使用 tools/.codex-cli 中的项目本地版本
# CODEX_COMMAND=C:\path\to\codex.cmd

# 流水线参数
LLM_BATCH_SIZE=40
# 原始 JSON 字符软上限；0=不限制，长上下文研究轮建议 60000
LLM_MAX_BATCH_CHARS=0

# OpenAI 兼容 API 备用后端（仅 LLM_BACKEND=api 时使用）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_CONCURRENCY=4
LLM_MAX_TOKENS=16000
